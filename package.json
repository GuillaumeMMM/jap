{
  "name": "jap",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "repository": "https://github.com/GuillaumeMMM/jap.git",
  "author": "GuillaumeMgz <guillaume.meigniez@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "npm-run-all --parallel build:watch serve",
    "serve": "web-dev-server --node-resolve --watch --root-dir build",
    "build": "mkdir -p build && cp *.html build/ && cp -R src/assets build && esbuild app.ts src/styles/global.css --bundle --outdir=build --minify --format=esm",
    "build:watch": "npm run build -- --watch"
  },
  "dependencies": {
    "@guillaumemmm/marquedefabrique": "^1.0.2",
    "@lit-labs/router": "^0.1.3",
    "@lit/context": "^1.1.2",
    "@lit/task": "^1.0.1",
    "lit": "^3.2.0",
    "typescript": "^5.5.4",
    "urlpattern-polyfill": "^10.0.0"
  },
  "devDependencies": {
    "@web/dev-server": "^0.4.6",
    "esbuild": "0.23.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-serve": "^1.0.1",
    "npm-run-all": "^4.1.5"
  }
}
